            "InteractionName": "Interaction4",
            "Trigger": {
              "Type": "TriggerSliderValueChanged",
              "TriggerComponent": "volumeSlider"
            },
            "Action": {
              "Type": "ActionExecuteCode",
              "Code": "Unicode::snprintf(volume_percentageBuffer, VOLUME_PERCENTAGE_SIZE, \"%d%%\", value);\r\nvolume_percentage.invalidate();"
            }
          },
