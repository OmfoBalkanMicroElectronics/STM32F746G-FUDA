          {
            "InteractionName": "Interaction2",
            "Trigger": {
              "Type": "TriggerSliderValueChanged",
              "TriggerComponent": "durationBar"
            },
            "Action": {
              "Type": "ActionExecuteCode",
              "Code": "int mins = value / 60;\r\nint secs = value % 60;\r\nUnicode::snprintf(currentSongDurBuffer, CURRENTSONGDUR_SIZE, \"%d:%02d\", mins, secs);\r\ncurrentSongDur.invalidate();"
            }
          },
          {
            "InteractionName": "Interaction3",
            "Trigger": {
